{
  "name": "@hnidboubker/readme-async",
  "version": "1.1.3",
  "description": "Keep your project's README.md synchronized with the actual codebase",
  "type": "module",
  "bin": {
    "readme-async": "scripts/install.js"
  },
  "files": [
    "SKILL.md",
    "README.md",
    "scripts/",
    "references/"
  ],
  "scripts": {
    "test": "echo \"No tests specified\" && exit 0",
    "release": "semantic-release"
  },
  "keywords": [
    "skill",
    "readme",
    "documentation",
    "sync",
    "claude",
    "claude-code"
  ],
  "author": "hnidboubker",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hnidboubker/readme-async.git"
  },
  "bugs": {
    "url": "https://github.com/hnidboubker/readme-async/issues"
  },
  "homepage": "https://github.com/hnidboubker/readme-async#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "semantic-release": "^25.0.9"
  }
}
